{
  "outputDirectory": "dist/public",
  "buildCommand": "pnpm run build",
  "installCommand": "cd ../.. && pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://app-production-ccfc.up.railway.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/ira",
      "destination": "/ira/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/buy",
      "destination": "/buy/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ]
}
